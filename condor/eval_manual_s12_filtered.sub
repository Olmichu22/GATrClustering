requirements = TARGET.Machine == "gaew0120.ciemat.es"

executable = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/condor/eval.sh

environment = "CKPT=/nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/results/manual_s12/20260804_112150_s12_manual_anchors_density/checkpoints/best-epoch079-acc1.0000.ckpt CFG=configs/eval_manual_s12_filtered.yml OUT=/nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/results/manual_s12/20260804_112150_s12_manual_anchors_density/eval_filtered_full DEVICE=cuda:0 EXPLORER_MAX=5000"

