requirements = TARGET.Machine == "gaew0120.ciemat.es"

executable = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/condor/eval70_s9b.sh

output = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/eval70_s9b.out
log    = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/eval70_s9b.log
error  = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/eval70_s9b.err

queue
