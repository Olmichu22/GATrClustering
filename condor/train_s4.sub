# HTCondor submit for the GATrClustering POC (train + eval), single GPU.
# Submit from the repo root:  condor_submit condor/train.sub
request_gpus = 2
# DDP spawns num_workers dataloader workers PER GPU rank (2 x 8 = 16) plus the
# two main processes; without request_cpus Condor grants ~1 core and the input
# pipeline starves the GPUs.

+CieRunInGpu3 = True
+CieMediumJob = True
requirements = TARGET.Machine == "gaew0120.ciemat.es"

executable = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/condor/train_s4.sh

output = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/poc_s4.out
log    = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/poc_s4.log
error  = /nfs/cms/arqolmo/SDHCAL_Energy/GATrClustering/logs/poc_s4.err

# Optional overrides (env passed to the executable):
# environment = "CFG=configs/poc.yml DATA=/path/to.h5 OUT=results/poc_run1 EPOCHS=100 DEVICE=cuda:0"
# environment = "RESUME=results/poc_run1/20260724_114007/checkpoints/last.ckpt"
queue
